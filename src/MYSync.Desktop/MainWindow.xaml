<Window x:Class="MYSync.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MYSync" Width="1080" Height="760" MinWidth="900" MinHeight="650" Background="#F5F6F8" FontFamily="Segoe UI" Foreground="#242830">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#343942"/><Setter Property="BorderBrush" Value="#DCE0E5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#D9293A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#D9293A"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DCE0E5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="22,12"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#D9293A" CornerRadius="12" Width="46" Height="46"><TextBlock Text="M" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="MYSync" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="내 컴퓨터와 클라우드를 한곳에서" Foreground="#7A818C" Margin="0,3,0,0"/></StackPanel></StackPanel><Border Grid.Column="1" Background="#FFF3E3" CornerRadius="12" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="테스트 버전 · 폴더 동기화" Foreground="#956015"/></Border></Grid></Border>
  <TabControl x:Name="MainTabs" Grid.Row="1" Margin="28,22,28,20" Background="Transparent" BorderThickness="0">
   <TabItem Header="동기화"><Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="동기화 폴더" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="연결한 컴퓨터 폴더와 클라우드 폴더를 관리하세요." Foreground="#747C88" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="＋ 동기화 추가" Style="{StaticResource Primary}" Click="ShowAdd" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E1E5EB" BorderThickness="1" Padding="16"><Grid><DataGrid ItemsSource="{Binding Pairs}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F1F4" HeadersVisibility="Column" RowHeight="56" ColumnHeaderHeight="42" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="클라우드" Binding="{Binding ProviderId}" Width="*"/><DataGridTextColumn Header="컴퓨터 폴더" Binding="{Binding LocalPath}" Width="2*"/><DataGridTextColumn Header="원격 폴더" Binding="{Binding RemoteFolderName}" Width="*"/><DataGridTemplateColumn Header="동작" Width="320"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="검사·실행" Click="OpenSync" Padding="8,5"/><Button Content="충돌·복구" Click="OpenResolve" Padding="8,5" Margin="6,0,0,0"/><Button Click="ToggleAuto" Padding="8,5" Margin="6,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="일시정지"/><Style.Triggers><DataTrigger Binding="{Binding Paused}" Value="True"><Setter Property="Content" Value="자동 시작"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Pairs.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="⇄" FontSize="52" Foreground="#D9293A" HorizontalAlignment="Center"/><TextBlock Text="첫 번째 폴더를 연결하세요" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock Text="동기화 추가에서 로컬·원격 폴더를 선택합니다." Foreground="#7A818C"/></StackPanel></Grid></Border>
   </Grid></TabItem>
   <TabItem Header="동기화 추가"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,22,0,0"><TextBlock Text="폴더 연결" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="계정을 연결하고 동기화할 두 폴더를 선택하세요." Foreground="#747C88" Margin="0,6,0,18"/>
    <Border Background="White" CornerRadius="10" Padding="22" BorderBrush="#E1E5EB" BorderThickness="1"><StackPanel><TextBlock Text="1   클라우드 계정" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="ProvidersBox" ItemsSource="{Binding Providers}" DisplayMemberPath="DisplayName" SelectionChanged="ProviderChanged"/><Button Grid.Column="1" Content="계정 연결" Click="ConnectProvider" Margin="12,0,0,0"/></Grid>
    <TextBlock Text="저장된 계정" Margin="0,14,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AccountsBox" DisplayMemberPath="DisplayName" SelectionChanged="AccountChanged"/><Button Grid.Column="1" Content="저장 계정 연결" Click="ReconnectAccount" Margin="12,0,0,0"/></Grid><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="이름 변경" Click="RenameAccount" Padding="10,6"/><Button Content="인증 정보 수정" Click="UpdateAccount" Margin="8,0,0,0" Padding="10,6"/><Button Content="계정 삭제" Click="DeleteAccount" Margin="8,0,0,0" Padding="10,6"/></StackPanel>
    <Separator Margin="0,20" Background="#E8EBEF"/>
    <TextBlock Text="2   컴퓨터 폴더" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/><DockPanel><Button Content="찾아보기…" Click="ChooseLocal" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox x:Name="LocalPathBox" IsReadOnly="True"/></DockPanel>
    <TextBlock Text="3   클라우드 폴더" FontWeight="SemiBold" FontSize="15" Margin="0,20,0,10"/><ComboBox x:Name="RemoteBox" DisplayMemberPath="Name"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="선택 폴더 열기" Click="BrowseRemote"/><Button Content="연결 루트로" Click="BrowseRoot" Margin="8,0,0,0"/></StackPanel><TextBlock Text="목록의 첫 항목은 현재 폴더입니다." Foreground="#7A818C" Margin="0,10,0,0"/>
    </StackPanel></Border><DockPanel Margin="0,18,0,0"><Button Content="폴더 연결 저장" Style="{StaticResource Primary}" Click="SavePair" DockPanel.Dock="Right"/><TextBlock Text="저장 후 자동 시작을 선택하면 추가·수정·삭제를 자동 반영합니다." Foreground="#7A818C" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="전송"><Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="전송 상태" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="수동 실행과 자동 감시의 진행 상황입니다. 진행률은 참고용이며 완료 판정에는 사용하지 않습니다." Foreground="#747C88" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E1E5EB" BorderThickness="1" Padding="16"><Grid><DataGrid ItemsSource="{Binding Transfers}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F1F4" HeadersVisibility="Column" RowHeight="44" ColumnHeaderHeight="42" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="동기화" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="상태" Binding="{Binding State}" Width="86"/><DataGridTextColumn Header="작업" Binding="{Binding Operation}" Width="86"/><DataGridTextColumn Header="진행" Binding="{Binding Progress}" Width="70"/><DataGridTextColumn Header="전송량" Binding="{Binding Transferred}" Width="90"/><DataGridTextColumn Header="현재 항목" Binding="{Binding Path}" Width="2*"/><DataGridTextColumn Header="갱신" Binding="{Binding Updated}" Width="80"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Transfers.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="⇅" FontSize="52" Foreground="#AAB1BC" HorizontalAlignment="Center"/><TextBlock Text="진행 중인 전송이 없습니다" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock Text="동기화 목록에서 검사·실행하거나 자동 시작하세요." Foreground="#7A818C"/></StackPanel></Grid></Border></Grid></TabItem>
   <TabItem Header="설정"><StackPanel Margin="0,26"><TextBlock Text="앱 정보" FontSize="22" FontWeight="SemiBold"/><Border Background="White" CornerRadius="10" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="MYSync · Windows 테스트 버전" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="WebDAV 계정은 현재 Windows 사용자에 묶어 암호화 저장합니다." Margin="0,16,0,8"/><TextBlock Text="지원 연결: HTTPS / Basic 인증"/><CheckBox x:Name="CloseToTrayBox" Content="창을 닫으면 트레이에서 계속 실행" Click="CloseToTrayChanged" Margin="0,20,0,10"/><CheckBox x:Name="StartupBox" Content="Windows 로그인 시 MYSync 실행" Click="StartupChanged" Margin="0,0,0,14"/><Button Content="MYSync 종료" Click="ExitApp" HorizontalAlignment="Left"/><TextBlock Text="트레이에서 창 열기 · 전체 일시정지 · 종료를 사용할 수 있습니다. Google Drive는 준비 중입니다." Margin="0,8,0,0" Foreground="#747C88"/></StackPanel></Border></StackPanel></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="28,14"><TextBlock x:Name="StatusText" Text="준비됨 · 계정 연결과 폴더 탐색을 시작하세요." TextWrapping="Wrap" Foreground="#687180"/></Border>
 </Grid>
</Window>
