<Window x:Class="MYSync.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MYSync" Icon="Assets/MYSync.ico" Width="1220" Height="800" MinWidth="1040" MinHeight="650" Background="#F5F6F8" FontFamily="Segoe UI" Foreground="#242830">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#343942"/><Setter Property="BorderBrush" Value="#DCE0E5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#D9293A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#D9293A"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DCE0E5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="22,12"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#D9293A" CornerRadius="12" Width="46" Height="46"><TextBlock Text="M" Foreground="White" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="14,0,0,0"><TextBlock Text="MYSync" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="내 컴퓨터와 클라우드를 한곳에서" Foreground="#7A818C" Margin="0,3,0,0"/></StackPanel></StackPanel><Border Grid.Column="1" Background="#FFF3E3" CornerRadius="12" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="테스트 버전 · 폴더 동기화" Foreground="#956015"/></Border></Grid></Border>
  <TabControl x:Name="MainTabs" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0">
   <TabControl.Resources>
    <Style TargetType="TabItem"><Setter Property="Padding" Value="18,15"/><Setter Property="Margin" Value="10,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="NavSurface" TextElement.Foreground="#596373" TextElement.FontSize="15" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#FDECEF"/><Setter TargetName="NavSurface" Property="TextElement.Foreground" Value="#C32638"/><Setter TargetName="NavSurface" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#F2F3F6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   </TabControl.Resources>
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0"><DockPanel Margin="0,20,0,12"><TextBlock DockPanel.Dock="Top" Text="내 작업 공간" Foreground="#929AA6" FontSize="12" Margin="28,0,0,16"/><TextBlock DockPanel.Dock="Bottom" Text="MYSync · 폴더 동기화" Foreground="#929AA6" FontSize="11" Margin="22,12"/><ItemsPresenter KeyboardNavigation.TabNavigation="Once"/></DockPanel></Border><ContentPresenter Grid.Column="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="24,0,24,20"/></Grid></ControlTemplate></TabControl.Template>
   <TabItem Header="⇄   동기화"><Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="동기화 폴더" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="연결한 컴퓨터 폴더와 클라우드 폴더를 관리하세요." Foreground="#747C88" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="＋ 동기화 추가" Style="{StaticResource Primary}" Click="ShowAdd" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E1E5EB" BorderThickness="1" Padding="16"><Grid><DataGrid ItemsSource="{Binding Pairs}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F1F4" HeadersVisibility="Column" RowHeight="82" ColumnHeaderHeight="42" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="클라우드" Binding="{Binding ProviderId}" Width="*" MinWidth="100"/><DataGridTextColumn Header="컴퓨터 폴더" Binding="{Binding LocalPath}" Width="2*" MinWidth="180"/><DataGridTextColumn Header="원격 폴더" Binding="{Binding RemoteFolderName}" Width="*" MinWidth="120"/><DataGridTemplateColumn Header="동작" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><WrapPanel VerticalAlignment="Center"><Button Click="ToggleAuto" Padding="8,5" Margin="6,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="자동 켜짐"/><Setter Property="ToolTip" Value="변경 감시가 유지됩니다. 클릭하면 일시정지합니다."/><Setter Property="Foreground" Value="#21805A"/><Style.Triggers><DataTrigger Binding="{Binding Paused}" Value="True"><Setter Property="Content" Value="자동 시작"/><Setter Property="ToolTip" Value="자동 동기화와 지속적인 변경 감시를 시작합니다."/><Setter Property="Foreground" Value="#343942"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="설정" Click="EditPairOptions" Padding="8,5" Margin="6,0,0,0"/></WrapPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Pairs.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="⇄" FontSize="52" Foreground="#D9293A" HorizontalAlignment="Center"/><TextBlock Text="첫 번째 폴더를 연결하세요" FontSize="20" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock Text="동기화 추가에서 로컬·원격 폴더를 선택합니다." Foreground="#7A818C"/></StackPanel></Grid></Border>
   </Grid></TabItem>
   <TabItem x:Name="PairEditorHost" Visibility="Collapsed">
    <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="EditorHeading" Text="두 폴더를 하나로 연결" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="컴퓨터와 클라우드의 파일 변경 내용을 양방향으로 동기화합니다." Foreground="#747C88" Margin="0,6,0,18"/>
      <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#E1E5EB" BorderThickness="1"><StackPanel>
       <TextBlock Text="01  클라우드 계정" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="ProvidersBox" ItemsSource="{Binding Providers}" DisplayMemberPath="DisplayName" SelectionChanged="ProviderChanged" Margin="0,0,12,0"/>
        <ComboBox Grid.Column="1" x:Name="AccountsBox" DisplayMemberPath="DisplayName" SelectionChanged="AccountChanged" ToolTip="저장된 계정 선택"/>
        <Button Grid.Column="2" Content="저장 계정 연결" Click="ReconnectAccount" Margin="12,0,0,0"/>
       </Grid>
       <DockPanel Margin="0,12,0,0"><Button x:Name="ConnectProviderButton" DockPanel.Dock="Right" Content="새 계정 연결" Click="ConnectProvider" Style="{StaticResource Primary}" Margin="12,0,0,0"/><TextBlock x:Name="ConnectionState" Text="계정을 연결하면 클라우드 폴더가 표시됩니다." Foreground="#596879" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
       <Expander Header="계정 관리" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="이름 변경" Click="RenameAccount" Padding="10,6"/><Button x:Name="UpdateAccountButton" Content="인증 정보 수정" Click="UpdateAccount" Margin="8,0,0,0" Padding="10,6"/><Button Content="계정 삭제" Click="DeleteAccount" Margin="8,0,0,0" Padding="10,6"/></StackPanel></Expander>
      </StackPanel></Border>
      <Grid Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#E1E5EB" BorderThickness="1"><StackPanel>
        <TextBlock Text="02  컴퓨터 폴더" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="하위 폴더를 포함하여 연결합니다." Foreground="#747C88" Margin="0,8,0,18"/>
        <TextBox x:Name="LocalPathBox" IsReadOnly="True" TextChanged="PreviewChanged" TextWrapping="Wrap" MinHeight="60"/>
        <Button Content="컴퓨터에서 폴더 선택…" Click="ChooseLocal" HorizontalAlignment="Left" Margin="0,14,0,0"/>
        <Button Content="제외 파일 · 속도 제한 설정" Click="EditDraftOptions" HorizontalAlignment="Left" Margin="0,14,0,0"/><TextBlock Text="기존 연결과 같은 폴더도 추가할 수 있습니다." Foreground="#747C88" TextWrapping="Wrap" Margin="0,18,0,0"/>
       </StackPanel></Border>
       <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="20" BorderBrush="#E1E5EB" BorderThickness="1"><StackPanel>
        <TextBlock Text="03  클라우드 폴더" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="목록에서 동기화할 폴더를 선택하세요." Foreground="#747C88" Margin="0,8,0,12"/>
        <ListBox x:Name="RemoteBox" DisplayMemberPath="Name" SelectionChanged="PreviewChanged" Height="132" BorderBrush="#DCE0E5" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,7"/></Style></ListBox.ItemContainerStyle></ListBox>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="선택 폴더 열기" Click="BrowseRemote" Padding="10,7"/><Button Content="연결 루트로" Click="BrowseRoot" Margin="8,0,0,0" Padding="10,7"/></StackPanel>
        <TextBlock Text="첫 항목은 현재 폴더입니다." Foreground="#747C88" Margin="0,8,0,0"/>
       </StackPanel></Border>
      </Grid>
     </StackPanel></ScrollViewer>
     <Border Grid.Row="1" Background="#EDEFF3" CornerRadius="10" Padding="18" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,18,0"><TextBlock Text="연결 미리보기" FontWeight="SemiBold"/><TextBlock x:Name="PreviewLocal" Text="컴퓨터 폴더를 선택하세요" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/><TextBlock x:Name="PreviewRemote" Text="클라우드 폴더를 선택하세요" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock x:Name="OverlapHint" Text="저장 후 검사·실행으로 변경 내용을 확인하세요." Foreground="#687180" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
      <Button Grid.Column="1" x:Name="SavePairButton" Content="동기화 연결 저장" IsEnabled="False" Style="{StaticResource Primary}" Click="SavePair" VerticalAlignment="Center"/>
     </Grid></Border>
    </Grid>
   </TabItem>
   <TabItem Header="↓↑   전송"><Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="전송 기록" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="새 작업이 위에 표시됩니다. 이번 실행의 최근 1,000개 기록을 보관합니다." Foreground="#747C88" Margin="0,6,0,0"/><TextBlock Text="평균 속도는 검사·검증 시간을 포함한 파일 처리량 기준입니다." Foreground="#747C88" Margin="0,4,0,0"/><WrapPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="선택 중지" Tag="중지" Click="HoldTransfer"/><Button Content="선택 취소" Tag="취소" Click="HoldTransfer" Margin="8,0,0,0"/><Button Content="오류 해결…" Click="OpenTransferResolution" Margin="8,0,0,0"/><Button Content="이번만 제외" Click="SkipTransferOnce" Margin="8,0,0,0"/><Button Content="재개" Click="ResumeTransfer" Margin="8,0,0,0"/><Button Content="동기화에서 제외" Click="ExcludeTransfer" Margin="8,0,0,0"/></WrapPanel></StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#E1E5EB" BorderThickness="1" Padding="12">
     <Grid><DataGrid x:Name="TransfersGrid" ItemsSource="{Binding Transfers}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" EnableRowVirtualization="True" Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F1F4" HeadersVisibility="Column" RowHeight="48" ColumnHeaderHeight="42" SelectionMode="Single">
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Details}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="확인 필요"><Setter Property="Foreground" Value="#BE5615"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="완료"><Setter Property="Foreground" Value="#237753"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
      <DataGrid.Columns>
       <DataGridTextColumn Header="파일 / 폴더" Binding="{Binding Path}" Width="2*" MinWidth="140"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
       <DataGridTextColumn Header="연결" Binding="{Binding Name}" Width="*" MinWidth="80"/>
       <DataGridTextColumn Header="작업" Binding="{Binding Operation}" Width="76"/>
       <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="88"/>
       <DataGridTextColumn Header="처리량" Binding="{Binding Transferred}" Width="85"/>
       <DataGridTextColumn Header="평균 속도" Binding="{Binding Speed}" Width="95"/>
       <DataGridTextColumn Header="소요 시간" Binding="{Binding Duration}" Width="85"/>
       <DataGridTextColumn Header="시작 시각" Binding="{Binding Started}" Width="120"/>
       <DataGridTextColumn Header="완료 시각" Binding="{Binding Finished}" Width="120"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="아직 전송 기록이 없습니다. 동기화를 시작하면 파일별로 표시됩니다." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#747C88"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Transfers.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
    </Border>
   </Grid></TabItem>
   <TabItem x:Name="AlertsTab" Header="!    알림·오류"><Grid Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
    <TextBlock Text="확인이 필요한 오류" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <ListBox Grid.Row="1" x:Name="AlertsBox" ItemsSource="{Binding Alerts}" DisplayMemberPath="Title" Padding="10"/>
    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20" Margin="0,12,0,0"><DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="일시정지 후 충돌·복구 열기" Click="ResolveAlert"/><Button Content="해당 계정 설정" Click="AlertAccount" Margin="12,0,0,0"/></StackPanel>
     <TextBox VerticalContentAlignment="Top" Text="{Binding SelectedItem.Message, ElementName=AlertsBox, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
    </DockPanel></Border>
   </Grid></TabItem>
   <TabItem Header="⚙   설정">
    <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Background="White" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="환경 설정" FontSize="19" FontWeight="SemiBold" Margin="8,8,0,20"/><ListBox x:Name="SettingsNavigation" SelectedIndex="0" BorderThickness="0"><ListBoxItem Content="일반" Padding="16,14"/><ListBoxItem Content="동기화 · 전송" Padding="16,14"/><ListBoxItem Content="로그 · 진단" Padding="16,14"/><ListBoxItem Content="앱 정보" Padding="16,14"/></ListBox></StackPanel></Border>
     <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="26">
      <TabControl SelectedIndex="{Binding SelectedIndex, ElementName=SettingsNavigation}" BorderThickness="0">
       <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
       <TabItem Header="일반"><StackPanel><TextBlock Text="일반 설정" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Windows 시작과 창 닫기 동작을 설정합니다." Foreground="#747C88" Margin="0,8,0,26"/><CheckBox x:Name="StartupBox" Content="Windows 로그인 시 MYSync 실행" Click="StartupChanged" Margin="0,0,0,20"/><CheckBox x:Name="CloseToTrayBox" Content="창을 닫으면 트레이에서 동기화 유지" Click="CloseToTrayChanged"/><Separator Margin="0,26"/><TextBlock Text="오류 알림" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="확인이 필요한 오류는 트레이 알림으로 표시됩니다. 알림을 클릭하면 해당 오류를 확인할 수 있습니다." TextWrapping="Wrap" Foreground="#747C88" Margin="0,10,0,0"/></StackPanel></TabItem>
       <TabItem Header="동기화"><StackPanel><TextBlock Text="동기화 · 전송" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="연결마다 필요한 파일과 전송 속도를 설정하세요." Foreground="#747C88" Margin="0,8,0,24"/><TextBlock Text="제외 규칙과 속도 제한" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="동기화 목록의 설정에서 제외할 파일·폴더와 KiB/s 한도를 지정합니다. 0은 무제한입니다." TextWrapping="Wrap" Margin="0,10,0,20"/><Button Content="동기화 연결 관리" Click="ShowSync" HorizontalAlignment="Left"/><Separator Margin="0,24"/><TextBlock Text="파일별 제어" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="전송 화면에서 대기·전송 파일을 중지하거나 취소하고 재개할 수 있습니다. 제외는 연결에 저장됩니다." TextWrapping="Wrap" Margin="0,10,0,20"/><Button Content="전송 목록 열기" Click="ShowTransfers" HorizontalAlignment="Left"/></StackPanel></TabItem>
       <TabItem Header="로그"><StackPanel><TextBlock Text="로그 · 진단" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="전송 상태와 오류 코드를 기록합니다." Foreground="#747C88" Margin="0,8,0,24"/><TextBlock Text="로그 최대 크기 (MiB)" FontWeight="SemiBold"/><TextBox x:Name="LogLimitBox" Width="150" HorizontalAlignment="Left" Margin="0,10,0,10"/><TextBlock Text="1~1024 MiB · 한도에 도달하면 오래된 행을 지우고 최신 기록을 보관합니다." TextWrapping="Wrap" Foreground="#747C88"/><Button Content="로그 설정 저장" Style="{StaticResource Primary}" Click="SaveLogSettings" HorizontalAlignment="Left" Margin="0,18,0,22"/><Separator/><TextBlock Text="저장 위치" FontWeight="SemiBold" Margin="0,18,0,8"/><TextBlock x:Name="LogPathText" TextWrapping="Wrap" Foreground="#747C88"/><Button Content="로그 폴더 열기" Click="OpenLogs" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></TabItem>
       <TabItem Header="정보"><StackPanel><TextBlock Text="MYSync" FontSize="28" FontWeight="SemiBold" Foreground="#D9293A"/><TextBlock Text="Windows 파일 동기화" FontSize="16" Margin="0,8,0,24"/><TextBlock Text="Google Drive · WebDAV · Provider 플러그인" Margin="0,0,0,12"/><TextBlock Text="계정 토큰은 현재 Windows 사용자에 묶어 암호화 저장합니다." TextWrapping="Wrap" Foreground="#747C88"/><Separator Margin="0,24"/><Button Content="MYSync 종료" Click="ExitApp" HorizontalAlignment="Left"/></StackPanel></TabItem>
      </TabControl>
     </Border>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="28,12">
   <StackPanel>
