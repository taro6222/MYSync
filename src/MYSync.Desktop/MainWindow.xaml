<Window x:Class="MYSync.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MYSync" Width="960" Height="620" MinWidth="760" MinHeight="480" Background="#F4F6FA">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="MYSync" FontSize="30" FontWeight="Bold"/><TextBlock Text="폴더 동기화 · 1단계 기반 구성" Foreground="#526075" Margin="0,6,0,20"/></StackPanel>
 <StackPanel Grid.Row="1"><TextBlock Text="클라우드 Provider"/><ComboBox x:Name="ProvidersBox" ItemsSource="{Binding Providers}" DisplayMemberPath="DisplayName" SelectionChanged="ProviderChanged" Margin="0,6,0,12"/><Button Content="계정 연결 (현재 실행 동안)" Click="ConnectProvider" HorizontalAlignment="Right" Padding="14,6" Margin="0,0,0,10"/><DockPanel><Button Content="로컬 폴더 선택" Click="ChooseLocal" Padding="14,8" DockPanel.Dock="Right"/><TextBox x:Name="LocalPathBox" IsReadOnly="True" Margin="0,0,10,0" VerticalContentAlignment="Center"/></DockPanel><TextBlock Text="원격 폴더 (목록 첫 항목은 현재 폴더)" Margin="0,12,0,6"/><ComboBox x:Name="RemoteBox" DisplayMemberPath="Name"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="선택 폴더 열기" Click="BrowseRemote" Padding="10,5"/><Button Content="연결 루트로" Click="BrowseRoot" Padding="10,5" Margin="8,0,0,0"/></StackPanel><Button Content="동기화 쌍 저장" Click="SavePair" HorizontalAlignment="Right" Padding="18,8" Margin="0,12,0,18"/></StackPanel>
 <DataGrid Grid.Row="2" ItemsSource="{Binding Pairs}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Provider" Binding="{Binding ProviderId}" Width="*"/><DataGridTextColumn Header="로컬 폴더" Binding="{Binding LocalPath}" Width="2*"/><DataGridTextColumn Header="원격 폴더" Binding="{Binding RemoteFolderName}" Width="*"/></DataGrid.Columns></DataGrid>
 <TextBlock Grid.Row="3" x:Name="StatusText" Text="설정 저장만 지원합니다. 실제 파일 전송은 아직 구현되지 않았습니다." TextWrapping="Wrap" Margin="0,16,0,0" Foreground="#526075"/>
 </Grid>
</Window>
